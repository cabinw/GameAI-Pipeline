{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://gameai-pipeline.dev/schemas/character-semantic-events/v1.0.0",
  "title": "GameAI Character Semantic Events",
  "description": "Engine-neutral animation-timeline semantic events and VFX cue definitions.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "rig", "vfxCues", "tracks"],
  "properties": {
    "schemaVersion": { "$ref": "#/definitions/schemaVersion" },
    "rig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layoutId", "schemaVersion"],
      "properties": {
        "layoutId": { "$ref": "#/definitions/identifier" },
        "schemaVersion": { "$ref": "#/definitions/schemaVersion" }
      }
    },
    "vfxCues": {
      "type": "array",
      "items": { "$ref": "#/definitions/vfxCue" }
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/eventTrack" }
    }
  },
  "definitions": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
    },
    "vector2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "scale2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "not": { "const": 0 } },
        "y": { "type": "number", "not": { "const": 0 } }
      }
    },
    "localTransform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "rotationDegrees", "scale"],
      "properties": {
        "position": { "$ref": "#/definitions/vector2" },
        "rotationDegrees": { "type": "number" },
        "scale": { "$ref": "#/definitions/scale2" }
      }
    },
    "followPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position", "rotation", "scale"],
      "properties": {
        "position": { "type": "boolean" },
        "rotation": { "type": "boolean" },
        "scale": { "type": "boolean" }
      }
    },
    "vfxPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "cueDefinitionId"],
      "properties": {
        "kind": { "const": "vfx" },
        "cueDefinitionId": { "$ref": "#/definitions/identifier" }
      }
    },
    "audioPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "volume", "pitch"],
      "properties": {
        "kind": { "const": "audio" },
        "volume": { "type": "number", "minimum": 0, "maximum": 1 },
        "pitch": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "gameplayPayload": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "action", "windowId"],
          "properties": {
            "kind": { "const": "gameplay" },
            "action": {
              "type": "string",
              "enum": ["window-open", "window-close"]
            },
            "windowId": { "$ref": "#/definitions/identifier" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "action"],
          "properties": {
            "kind": { "const": "gameplay" },
            "action": { "const": "signal" }
          }
        }
      ]
    },
    "semanticEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "timeSeconds",
        "eventKind",
        "semanticCueId",
        "localTransform",
        "followPolicy",
        "lifecycle",
        "order",
        "payload"
      ],
      "properties": {
        "eventId": { "$ref": "#/definitions/identifier" },
        "timeSeconds": { "type": "number", "minimum": 0 },
        "eventKind": {
          "type": "string",
          "enum": ["vfx", "audio", "gameplay"]
        },
        "semanticCueId": { "$ref": "#/definitions/identifier" },
        "socketId": { "$ref": "#/definitions/identifier" },
        "localTransform": { "$ref": "#/definitions/localTransform" },
        "layerRole": { "$ref": "#/definitions/identifier" },
        "followPolicy": { "$ref": "#/definitions/followPolicy" },
        "lifecycle": {
          "type": "string",
          "enum": ["one-shot", "looping", "persistent"]
        },
        "durationSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "order": { "type": "integer", "minimum": 0 },
        "payload": {
          "oneOf": [
            { "$ref": "#/definitions/vfxPayload" },
            { "$ref": "#/definitions/audioPayload" },
            { "$ref": "#/definitions/gameplayPayload" }
          ]
        }
      }
    },
    "eventTrack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trackId", "clipId", "events"],
      "properties": {
        "trackId": { "$ref": "#/definitions/identifier" },
        "clipId": { "$ref": "#/definitions/identifier" },
        "events": {
          "type": "array",
          "items": { "$ref": "#/definitions/semanticEvent" }
        }
      }
    },
    "color": {
      "type": "object",
      "additionalProperties": false,
      "required": ["r", "g", "b", "a"],
      "properties": {
        "r": { "type": "number", "minimum": 0, "maximum": 1 },
        "g": { "type": "number", "minimum": 0, "maximum": 1 },
        "b": { "type": "number", "minimum": 0, "maximum": 1 },
        "a": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "vfxCue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cueId", "effectKind", "visualIntent"],
      "properties": {
        "cueId": { "$ref": "#/definitions/identifier" },
        "effectKind": {
          "type": "string",
          "enum": ["burst", "trail", "continuous"]
        },
        "visualIntent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "color": { "$ref": "#/definitions/color" },
        "intensity": { "type": "number", "exclusiveMinimum": 0 },
        "size": { "type": "number", "exclusiveMinimum": 0 },
        "defaultDurationSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  }
}
